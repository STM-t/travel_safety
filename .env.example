# ===== База данных =====
POSTGRES_USER=trisp
POSTGRES_PASSWORD=trisp_secret
POSTGRES_DB=trisp
DATABASE_URL=postgresql+asyncpg://trisp:trisp_secret@localhost:5432/trisp

# ===== Кэш =====
REDIS_URL=redis://localhost:6379/0
# TTL кэша внешних API, секунд (12 часов)
CACHE_TTL_SECONDS=43200

# ===== AI (OpenAI-совместимый) =====
# Оставьте LLM_API_KEY пустым — сработает детерминированный rule-based fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
